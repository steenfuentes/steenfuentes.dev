# Frontend Environment Variables

# API URL - In production, this should be your backend API URL
# For Cloud Run with same project: https://backend-service-name-projectid.a.run.app/api
# For same domain proxy: /api
VITE_API_URL=http://localhost:8080

# Public URL of your frontend (used for redirects, etc.)
PUBLIC_URL=http://localhost:5173

# Node environment
NODE_ENV=development