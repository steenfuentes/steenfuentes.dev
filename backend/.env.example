# Server
PORT=8080
ENVIRONMENT=development

# Authentication
# Set to "false" to disable authentication (useful for local development)
AUTH_ENABLED=true

# Database
DATA_DIR=./data
MIGRATIONS_PATH=./migrations

# GitHub OAuth (only required if AUTH_ENABLED=true)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/github/callback
GITHUB_ALLOWED_USER=steenfuentes

# Frontend
FRONTEND_URL=http://localhost:5173